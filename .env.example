# Copy to .env only to override defaults. Docker Compose reads it automatically.
# Linux bind mount ownership (PowerShell / Docker Desktop can use the defaults).
RL_VLA_UID=1000
RL_VLA_GID=1000
# "openpi" is the GPU service; use host.docker.internal for a host policy server,
# or the DNS name/IP of a remote GPU server reachable from this container.
RL_VLA_OPENPI_HOST=openpi
RL_VLA_OPENPI_PORT=8000
# The server port stays 8000 inside Docker. This is the host-published port.
OPENPI_BIND_ADDRESS=127.0.0.1
OPENPI_PORT=8000
OPENPI_MODEL_CONFIG=pi05_libero
OPENPI_CHECKPOINT_DIR=/checkpoints/pi05_libero
